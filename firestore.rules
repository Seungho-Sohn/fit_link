rules_version = '2';

// FIT LINK Firestore 보안 규칙 (원본: 저장소의 firestore.rules)
// 콘솔 → Firestore → 규칙 탭에 이 파일 내용을 그대로 붙여넣고 "게시".
//
// - 회원 제보(gear_reports)만 공유한다. 누구나 읽을 수 있고, 쓰기는 익명 로그인한 앱이
//   자기 uid로 된 문서만. 지우기는 막는다.
// - 운영자 보유 기구 등록은 운영자 인증이 생기기 전까지 공유하지 않으므로 서버 경로가 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // 회원 제보: gear_reports/{uid}__{헬스장}__{기구ID}
    match /gear_reports/{reportId} {
      function validReport() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'gym', 'gear', 'present', 'at'])
          && d.uid == request.auth.uid
          && reportId.matches(request.auth.uid + '__.+__.+')
          && shortString(d.gym, 60)
          && shortString(d.gear, 60)
          && d.present is bool
          && d.at == request.time;
      }

      allow read: if true;
      allow create, update: if request.auth != null && validReport();
      allow delete: if false;
    }

    // 그 밖의 모든 문서는 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
