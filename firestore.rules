rules_version = '2';

// FIT LINK Firestore 보안 규칙
// 콘솔 → Firestore Database → 규칙 탭에 이 파일 내용을 그대로 붙여넣고 "게시".
//
// - 누구나 읽을 수 있다 (헬스장 보유 기구는 공개 정보).
// - 쓰기는 익명 로그인한 앱만. 헬스장 등록은 처음 등록한 사람(owner)만 고칠 수 있고,
//   제보는 자기 uid로 된 문서만 쓸 수 있다. 지우기는 막는다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // 운영자 보유 기구 등록: gym_gear/{헬스장}
    match /gym_gear/{gymId} {
      function validGym() {
        let d = request.resource.data;
        return d.keys().hasOnly(['gym', 'gear', 'owner', 'updatedAt'])
          && shortString(d.gym, 60)
          && d.gear is list && d.gear.size() >= 1 && d.gear.size() <= 300
          && d.owner == request.auth.uid
          && d.updatedAt == request.time;
      }

      allow read: if true;
      allow create: if signedIn() && validGym();
      allow update: if signedIn() && resource.data.owner == request.auth.uid && validGym();
      allow delete: if false;
    }

    // 회원 제보: gear_reports/{uid}__{헬스장}__{기구ID}
    match /gear_reports/{reportId} {
      function validReport() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'gym', 'gear', 'present', 'at'])
          && d.uid == request.auth.uid
          && reportId.matches(request.auth.uid + '__.+__.+')
          && shortString(d.gym, 60)
          && shortString(d.gear, 60)
          && d.present is bool
          && d.at == request.time;
      }

      allow read: if true;
      allow create, update: if signedIn() && validReport();
      allow delete: if false;
    }

    // 그 밖의 모든 문서는 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
